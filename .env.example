# Arion — Local Environment Example
# Copy this file to `.env.local` and fill in your local or project Supabase credentials.
# Never commit `.env.local` or real secrets to Git.

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional support contact email shown in "Assistenza tecnica e feedback"
VITE_SUPPORT_EMAIL=
